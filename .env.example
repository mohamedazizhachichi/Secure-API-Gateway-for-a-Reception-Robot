# =============================================================================
# .env.example — Copy to .env and fill in real values before `docker-compose up`
# NEVER commit the actual .env file (see ENF-05 / ENF-08). It is gitignored.
# =============================================================================

# ---- PostgreSQL (Kong) ----
KONG_PG_DB=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=change_me_kong_db_password

# ---- PostgreSQL (Keycloak) ----
KEYCLOAK_PG_DB=keycloak
KEYCLOAK_PG_USER=keycloak
KEYCLOAK_PG_PASSWORD=change_me_keycloak_db_password

# ---- Keycloak bootstrap admin (local/demo only) ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password
KEYCLOAK_REALM=robot-realm
# Internal hostname used by other containers to reach Keycloak
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ---- Robot OAuth2 Client Credentials (Sprint 3 will populate real values) ----
ROBOT_CLIENT_ID=robot-service
ROBOT_CLIENT_SECRET=change_me_robot_client_secret

# ---- Dashboard OAuth2 Authorization Code client ----
DASHBOARD_CLIENT_ID=dashboard-app
DASHBOARD_CLIENT_SECRET=change_me_dashboard_client_secret

# ---- Demo human users for local testing (temporary passwords, force reset) ----
DEMO_ADMIN_PASSWORD=change_me_demo_admin_password
DEMO_OPERATOR_PASSWORD=change_me_demo_operator_password

# ---- JWT lifetimes (seconds) — enforced in Keycloak realm/client config ----
ROBOT_JWT_TTL_SECONDS=300
DASHBOARD_JWT_TTL_SECONDS=900

# ---- Redis (rate limiting backend for Kong) ----
REDIS_PASSWORD=change_me_redis_password

# ---- FastAPI services ----
ROBOT_SERVICE_PORT=8001
DASHBOARD_SERVICE_PORT=8002
# ENF-06: robot target URL is parameterized, not hardcoded, even though
# only the simulated robot is in scope for this internship.
ROBOT_SERVICE_URL=http://robot-service:8001

# ---- Kong ----
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8444
