{
  "realm": "robot-realm",
  "enabled": true,
  "displayName": "Robot Reception - Realm",
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Full access: view visitor logs, command robot movement, modify robot parameters."
      },
      {
        "name": "operator",
        "description": "Can view visitor logs and command robot movement. Cannot modify robot parameters."
      },
      {
        "name": "robot",
        "description": "M2M identity for the simulated robot. Sends data only; cannot read visitor logs or modify its own parameters."
      }
    ]
  },
  "clients": [
    {
      "clientId": "robot-service",
      "name": "Simulated Robot (M2M)",
      "description": "OAuth2 Client Credentials client for the simulated reception robot, per EF-05.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.ROBOT_CLIENT_SECRET}",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "defaultClientScopes": [
        "profile",
        "roles"
      ]
    },
    {
      "clientId": "dashboard-app",
      "name": "Supervision Dashboard",
      "description": "OAuth2 Authorization Code client for human dashboard users (admin/operator), per Sprint 3 auth flows.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${env.DASHBOARD_CLIENT_SECRET}",
      "redirectUris": [
        "http://localhost:8002/*"
      ],
      "webOrigins": [
        "http://localhost:8002"
      ],
      "attributes": {
        "access.token.lifespan": "900"
      },
      "defaultClientScopes": [
        "profile",
        "roles",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "demo-admin",
      "enabled": true,
      "email": "demo-admin@example.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${env.DEMO_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "demo-operator",
      "enabled": true,
      "email": "demo-operator@example.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${env.DEMO_OPERATOR_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["operator"]
    }
  ]
}
